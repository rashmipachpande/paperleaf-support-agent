# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Passcode customers/testers must enter before the chat opens
APP_PASSCODE=your_secure_passcode

# Public CSV export link of the FAQ Google Sheet (Share -> "Anyone with the link: Viewer")
FAQ_CSV_URL=https://docs.google.com/spreadsheets/d/1sRaJ3wVQUy2omRVjrUhTTVzY9fK8ytCyRumZQZ9kb5Y/export?format=csv

# Optional
# GEMINI_MODEL=gemini-3.1-flash-lite
# FAQ_CACHE_TTL_SECONDS=300
# TICKETS_CSV_PATH=tickets.csv
